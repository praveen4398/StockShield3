# StockShield 2.0 Environment Configuration
# Copy to .env for local runtime settings

# Application Settings
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Provider / Live Mode (default is offline fixture mode)
DATA_PROVIDER_MODE=fixture  # options: fixture, live
YFINANCE_CACHE_TTL_SECONDS=3600

# LLM Adapter (default is deterministic stub for zero-cost testability)
LLM_PROVIDER=stub  # options: stub, gemini, local
GEMINI_API_KEY=
LLM_MODEL_NAME=gemini-3.8-flash

# Gemini LLM-as-a-Judge Evaluation Configuration
GEMINI_JUDGE_MODEL=gemini-3.8-flash  # options: gemini-3.8-flash, gemini-2.0-flash
LLM_JUDGE_ENABLED=false              # set to true to enable Gemini evaluation post-report
LLM_JUDGE_TIMEOUT_SECONDS=30         # timeout in seconds for Gemini judge API call

# GENI Conversational Assistant Configuration
GENI_MODEL=gemini-3.8-flash           # options: gemini-3.8-flash, gemini-3.5-flash
GENI_TIMEOUT_SECONDS=30               # timeout in seconds for GENI chat responses
STOCKSHIELD_GENI_DB=data/geni_chat.db # SQLite persistence path for multi-turn conversations

# Architecture & Execution Defaults
DEFAULT_WORKFLOW=sequential  # options: sequential, parallel, hierarchical
ENABLE_CALLBACKS=true
ENABLE_GUARDRAILS=true

# A2A and MCP Server Config
A2A_SERVER_PORT=8010
MCP_SERVER_PORT=8020
