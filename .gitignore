# ===========================================================================
# StockShield 2.0 — Production Git Ignore Rules
# ===========================================================================

# Python Bytecode & Compilation
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
env/
venv/
ENV/

# Environment Variables & Secrets (CRITICAL)
.env
*.env.local
*.env.*.local
secrets/

# SQLite Databases & Binary Storage (>100MB GitHub limit protection)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db
evaluation_results/experiments.db

# Testing, Linting & Coverage Caches
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# IDE & Tool Metadata
.idea/
.vscode/
*.swp
*.swo
.qodo/
.crewai/

# OS-Generated Files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary Scratch Scripts & Execution Logs
scratch/
*.log
evaluation_results/logs/

# Test-generated Temporary Snapshots
evaluation_results/snapshots/test_verify_*.json
evaluation_results/snapshots/run_*.json

.localappdata/
